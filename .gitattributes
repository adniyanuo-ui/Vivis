* text=auto
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.wav -text
*.onnx -text

# Preserve the pinned upstream SDK byte-for-byte, including its formatting.
src/vivis/hardware/feetech/_vendor/** -whitespace

# Unified patches encode an empty context line as one space; preserve its hash.
native/speech/voice_preserve/profile.patch whitespace=-blank-at-eol

# Seeta patches retain upstream context, including mixed indentation.
native/vision/seeta/*.patch -whitespace
