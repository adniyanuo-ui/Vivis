{
  "schema_version": "vivis-speech-1.0",
  "python": "outputs/speech/venv/bin/python",
  "capture": {
    "device": "DOV:",
    "sample_rate_hz": 48000,
    "channels": 2,
    "channel": 0,
    "frame_ms": 20,
    "queue_frames": 25
  },
  "sample_rate_hz": 16000,
  "asr": {
    "backend": "paraformer",
    "directory": "outputs/speech/models/paraformer_zh_en",
    "encoder": "encoder.int8.onnx",
    "decoder": "decoder.int8.onnx",
    "tokens": "tokens.txt",
    "threads": 2
  },
  "tts": {
    "engine": "dashscope",
    "model": "qwen3-tts-flash",
    "voice": "Ethan",
    "language": "Chinese",
    "speed": 1.0,
    "api_key_env": "DASHSCOPE_API_KEY",
    "endpoint": "https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation",
    "timeout_s": 60,
    "source_manifest": "native/speech/cloud_tts_sources.json"
  },
  "prompt_level": {
    "method": "r128",
    "reference_audio": "assets/works/0001/audio.wav",
    "relative_loudness_lu": -3.0,
    "true_peak_dbfs": -1.0,
    "compression_threshold_dbfs": -24.0,
    "compression_ratio": 4.0
  },
  "aec": {
    "enabled": true,
    "reference_port": 14788,
    "sample_rate_hz": 16000,
    "tail_ms": 200,
    "reference_delay_ms": 0,
    "noise_suppress_db": -15
  },
  "prompts": "assets/speech/xiaoshuai_ethan",
  "asr_final": {
    "directory": "outputs/speech/models/sensevoice",
    "model": "model.int8.onnx",
    "tokens": "tokens.txt",
    "threads": 2,
    "language": "zh",
    "enabled": true
  },
  "segmentation": {
    "aggressiveness": 2,
    "prefix_frames": 10,
    "min_speech_frames": 3,
    "silence_frames": 15,
    "max_frames": 600
  },
  "control_keywords": {
    "enabled": true,
    "directory": "outputs/speech/models/control_kws_zh",
    "encoder": "encoder-epoch-99-avg-1-chunk-16-left-64.int8.onnx",
    "decoder": "decoder-epoch-99-avg-1-chunk-16-left-64.onnx",
    "joiner": "joiner-epoch-99-avg-1-chunk-16-left-64.int8.onnx",
    "tokens": "tokens.txt",
    "keywords_file": "configs/perception/control_keywords.txt",
    "threads": 1,
    "keywords_score": 2.0,
    "keywords_threshold": 0.1,
    "confirmation_s": 0.25,
    "reference_guard_s": 0.75,
    "refractory_s": 1.5
  },
  "prompt_text_overrides": {
    "menu": "我会唱歌、演剧本，还能学你的表情。你想听歌，还是看我演一段？",
    "identity": "我是小帅，二十岁，北京男孩。我会唱歌、演剧本，还能学你的表情。",
    "clarify": "你可以说，唱歌、演剧本，或者学我的表情。"
  }
}
