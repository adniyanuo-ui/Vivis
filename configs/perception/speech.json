{
  "schema_version": "vivis-speech-1.0",
  "python": "outputs/speech/venv/bin/python",
  "capture": {
    "device": "DOV:",
    "sample_rate_hz": 48000,
    "channels": 2,
    "channel": 0,
    "frame_ms": 20,
    "queue_frames": 25
  },
  "sample_rate_hz": 16000,
  "asr": {
    "backend": "paraformer",
    "directory": "outputs/speech/models/paraformer_zh_en",
    "encoder": "encoder.int8.onnx",
    "decoder": "decoder.int8.onnx",
    "tokens": "tokens.txt",
    "threads": 2
  },
  "tts": {
    "engine": "qwen3",
    "python": "outputs/tts_qwen/venv/bin/python",
    "directory": "outputs/tts_qwen/model",
    "model": "model.safetensors",
    "source_manifest": "native/speech/qwen3_tts_sources.json",
    "speaker_id": 0,
    "speaker_name": "Dylan",
    "language": "Chinese",
    "speed": 1.0,
    "threads": 6,
    "max_new_tokens": 1024,
    "force_standard_chinese": true
  },
  "prompt_level": {
    "method": "r128",
    "reference_audio": "assets/works/0001/audio.wav",
    "relative_loudness_lu": -3.0,
    "true_peak_dbfs": -1.0,
    "compression_threshold_dbfs": -24.0,
    "compression_ratio": 4.0
  },
  "aec": {
    "enabled": true,
    "reference_port": 14788,
    "sample_rate_hz": 16000,
    "tail_ms": 200,
    "reference_delay_ms": 0,
    "noise_suppress_db": -15
  },
  "prompts": "assets/speech/xiaoshuai_qwen3_mandarin",
  "asr_final": {
    "directory": "outputs/speech/models/sensevoice",
    "model": "model.int8.onnx",
    "tokens": "tokens.txt",
    "threads": 2,
    "language": "zh",
    "enabled": true
  },
  "segmentation": {
    "aggressiveness": 2,
    "prefix_frames": 10,
    "min_speech_frames": 3,
    "silence_frames": 15,
    "max_frames": 600
  }
}
