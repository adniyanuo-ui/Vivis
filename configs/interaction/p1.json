{
  "schema_version": "vivis-dialog-programs-1.0",
  "programs": "configs/interaction/programs.json",
  "speech": "configs/perception/speech.json",
  "standby": "configs/interaction/standby.json",
  "robot": "configs/robots/xiaoshuai/robot.json",
  "max_event_age_s": 2.0,
  "cancel_timeout_s": 8.0,
  "expression_seconds": 600,
  "standby_seconds": 600,
  "soft_audio_cancel_ms": 40,
  "overlap_warmup": true,
  "diagnostics": false,
  "interaction": "configs/interaction/interaction.json",
  "interaction_seconds": 600,
  "warm_home_speed_counts_s": 120,
  "semantic": "configs/interaction/semantic.json",
  "conversation": "configs/interaction/conversation.json",
  "realtime_voice": {
    "enabled": true,
    "config": "configs/perception/realtime_voice.json",
    "region": "beijing",
    "profile": "voice-preserve",
    "board_reference_device": "DOV:",
    "lip_sync": {
      "enabled": true,
      "binary": "outputs/a2f/build/a2f_chunk_probe",
      "model": "outputs/a2f/model_bundle/model.json"
    },
    "control_backend": "qwen_realtime",
    "control_poll_interval_s": 0.05,
    "reception_config": "configs/interaction/reception.json",
    "memory_config": "configs/interaction/memory.json",
    "tasks_config": "configs/interaction/tasks.json"
  }
}
