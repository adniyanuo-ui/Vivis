{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FaceMotion-52 frame v1.0.0",
  "description": "52 named movement weights. Left/Right are anatomical. Weights are independent and do not sum to one. Null gaze/head_pose mean unavailable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp_ms",
    "blendshapes",
    "gaze",
    "head_pose"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "timestamp_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Target display time relative to audio sample zero, in milliseconds."
    },
    "blendshapes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyeBlinkLeft",
        "eyeLookDownLeft",
        "eyeLookInLeft",
        "eyeLookOutLeft",
        "eyeLookUpLeft",
        "eyeSquintLeft",
        "eyeWideLeft",
        "eyeBlinkRight",
        "eyeLookDownRight",
        "eyeLookInRight",
        "eyeLookOutRight",
        "eyeLookUpRight",
        "eyeSquintRight",
        "eyeWideRight",
        "jawForward",
        "jawLeft",
        "jawRight",
        "jawOpen",
        "mouthClose",
        "mouthFunnel",
        "mouthPucker",
        "mouthLeft",
        "mouthRight",
        "mouthSmileLeft",
        "mouthSmileRight",
        "mouthFrownLeft",
        "mouthFrownRight",
        "mouthDimpleLeft",
        "mouthDimpleRight",
        "mouthStretchLeft",
        "mouthStretchRight",
        "mouthRollLower",
        "mouthRollUpper",
        "mouthShrugLower",
        "mouthShrugUpper",
        "mouthPressLeft",
        "mouthPressRight",
        "mouthLowerDownLeft",
        "mouthLowerDownRight",
        "mouthUpperUpLeft",
        "mouthUpperUpRight",
        "browDownLeft",
        "browDownRight",
        "browInnerUp",
        "browOuterUpLeft",
        "browOuterUpRight",
        "cheekPuff",
        "cheekSquintLeft",
        "cheekSquintRight",
        "noseSneerLeft",
        "noseSneerRight",
        "tongueOut"
      ],
      "properties": {
        "eyeBlinkLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeLookDownLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeLookInLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeLookOutLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeLookUpLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeSquintLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeWideLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeBlinkRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeLookDownRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeLookInRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeLookOutRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeLookUpRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeSquintRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eyeWideRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "jawForward": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "jawLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "jawRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "jawOpen": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthClose": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthFunnel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthPucker": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthSmileLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthSmileRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthFrownLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthFrownRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthDimpleLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthDimpleRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthStretchLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthStretchRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthRollLower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthRollUpper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthShrugLower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthShrugUpper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthPressLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthPressRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthLowerDownLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthLowerDownRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthUpperUpLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mouthUpperUpRight": {
          "type": "number",
          "minimum": 0,
