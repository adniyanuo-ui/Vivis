        },
        "tongueOut": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "gaze": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction"
          ],
          "properties": {
            "direction": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      ],
      "description": "Optional unit direction in face-local X=subject left, Y=up, Z=forward; distinct from eye-look weights."
    },
    "head_pose": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "yaw_deg",
            "pitch_deg",
            "roll_deg"
          ],
          "properties": {
            "yaw_deg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "pitch_deg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "roll_deg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        }
      ],
      "description": "Optional right-handed intrinsic yaw(Y), pitch(X), roll(Z), degrees in the same face-local frame; mechanical limits are external."
    },
    "extensions": {
      "type": "object",
      "description": "Optional producer-specific data; core-only consumers may ignore it."
    }
  }
}
