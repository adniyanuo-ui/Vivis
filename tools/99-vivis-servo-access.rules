# Jetson Mojia deployment: grant only james access to this commissioned adapter.
# Keep the normal root:dialout ownership and mode; reapply ACL after enumeration.
ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5B79076878", RUN+="/usr/bin/setfacl -m u:james:rw $env{DEVNAME}"
